# ── Supabase ────────────────────────────────────────────
# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon key (client-safe, RLS-protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# service_role key — SERVER ONLY. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Cloudinary ──────────────────────────────────────────
# Dashboard → Product Environment Credentials
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=your-secret
# Preset used for signed uploads (see README for setup)
CLOUDINARY_UPLOAD_PRESET=kruv_portfolio

# ── Site ────────────────────────────────────────────────
# Tam URL (http/https şeması zorunlu). Örn: http://127.0.0.1:3000
# Sadece "127.0.0.1:3000" yazmak layout'ta Invalid URL → 500 üretir.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ── HubSpot (isteğe bağlı — iletişim formu API gönderimi) ─
# Marketing → Lead capture → Forms → form oluştur → embed ayarlarından Form GUID
# Settings → Account & defaults → Portal ID (veya Hub ID)
# Formda şu dahili alan adları olmalı (veya kodu form alanlarına göre güncelleyin):
#   firstname, lastname, email, message — isteğe bağlı: phone, company
# Gönderim: src/lib/contact-hubspot.ts → Forms API v3 integration submit
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# ── E-posta (Resend) — iletişim formu + Olly bekleme listesi ─
# https://resend.com/docs/dashboard/emails/send-email
RESEND_API_KEY=
# Gönderen: doğrulanmış domain veya Resend test adresi
RESEND_FROM=kruv <onboarding@resend.dev>
# İletişim formu bildirimleri bu adrese gider (ekip)
CONTACT_NOTIFY_EMAIL=hi@example.com
# IP hash tuzu (üretimde benzersiz tutun)
WAITLIST_IP_SALT=
