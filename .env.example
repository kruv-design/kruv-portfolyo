# ── Supabase ────────────────────────────────────────────
# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon key (client-safe, RLS-protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# service_role key — SERVER ONLY. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Cloudinary ──────────────────────────────────────────
# Dashboard → Product Environment Credentials
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=your-secret
# Preset used for signed uploads (see README for setup)
CLOUDINARY_UPLOAD_PRESET=kruv_portfolio

# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── HubSpot (isteğe bağlı — iletişim formu gönderimleri) ─
# Marketing → Lead capture → Forms → form GUID ve Settings → Account defaults → Portal ID
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
