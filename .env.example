# ── Supabase ────────────────────────────────────────────
# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon key (client-safe, RLS-protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# service_role key — SERVER ONLY. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Cloudinary ──────────────────────────────────────────
# Dashboard → Product Environment Credentials
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=your-secret
# Preset used for signed uploads (see README for setup)
CLOUDINARY_UPLOAD_PRESET=kruv_portfolio

# ── Site ────────────────────────────────────────────────
# Tam URL (http/https şeması zorunlu). Örn: http://127.0.0.1:3000
# Sadece "127.0.0.1:3000" yazmak layout'ta Invalid URL → 500 üretir.
# Üretim (Vercel): https://www.kruv.com
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ── Analytics (isteğe bağlı) ──────────────────────────────
# Ayarlanmazsa GA4/Clarity scriptleri yüklenmez (birinci taraf site_events ayrı).
# GA4 ölçüm kimliği: analytics.google.com → Veri akışları → Web → G-XXXXXXXXXX
#
# Vercel üretim: GA_MEASUREMENT_ID yeterli (sunucu env, anında etkili).
# Yerel / build-time yedek: NEXT_PUBLIC_GA_MEASUREMENT_ID
GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Clarity: clarity.microsoft.com → Settings → Project ID
CLARITY_PROJECT_ID=xxxxxxxxxx
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# ── /api/audit-summary (isteğe bağlı — Cowork site-audit görevi) ─
# Cowork'ün bulut sandbox'ı Supabase'e doğrudan bağlanamadığı için,
# site_events/site_presence'ı özetleyip döndüren bu route'u token ile
# korur. Aynı değeri site-audit/tracking.config.json > audit_summary_token
# alanına da yazın. Vercel'de Project Settings → Environment Variables'a
# da eklemeyi unutmayın (prod'da set edilmezse route 500 döner).
AUDIT_SUMMARY_TOKEN=

# ── Protel gizli teklif sayfası (/protel) ─────────────────
# Public sayfa şifresi — isteğe bağlı yedek; asıl şifre Supabase protel_page_secrets tablosunda
PROTEL_PAGE_PASSWORD=

# ── HubSpot (isteğe bağlı — iletişim formu API gönderimi) ─
# Marketing → Lead capture → Forms → form oluştur → embed ayarlarından Form GUID
# Settings → Account & defaults → Portal ID (veya Hub ID)
# Formda şu dahili alan adları olmalı (veya kodu form alanlarına göre güncelleyin):
#   firstname, lastname, email, message — isteğe bağlı: phone, company
# Gönderim: src/lib/contact-hubspot.ts → Forms API v3 integration submit
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# ── E-posta (Resend) — iletişim formu + drops indirme bildirimi + Olly ─
# Supabase yalnızca form kaydı tutar; mail için Resend şart.
#
# ÖNEMLİ — iki aşama:
# A) Test (domain doğrulanmadan):
#    RESEND_FROM=kruv <onboarding@resend.dev>
#    → Sadece Resend hesabınızdaki e-postaya (ör. hello@kruv.com) bildirim gider.
#    → Ziyaretçiye auto-reply GİTMEZ (Resend sandbox kısıtı).
# B) Canlı (kruv.com doğrulandıktan sonra):
#    RESEND_FROM=kruv <hello@kruv.com>
#    → Hem hello@kruv.com bildirimi hem ziyaretçi auto-reply çalışır.
#
# Kurulum:
# 1) resend.com → API Keys → Create → RESEND_API_KEY
# 2) Domains → Add kruv.com → GoDaddy DNS TXT/MX → Verify
# 3) Vercel → Settings → Environment Variables → Production (+ Preview):
#    RESEND_API_KEY, RESEND_FROM, CONTACT_NOTIFY_EMAIL
# 4) Deployments → Redeploy (env değişince zorunlu)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=kruv <hello@kruv.com>
CONTACT_NOTIFY_EMAIL=hello@kruv.com
# IP hash tuzu (üretimde benzersiz tutun)
WAITLIST_IP_SALT=
