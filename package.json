{
  "name": "kruv-portfolyo-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Kruv — production-ready portfolyo CMS (Next.js 15 + Supabase + Cloudinary)",
  "scripts": {
    "clean": "rm -rf .next \"$HOME/.cache/next-dist/kruv-portfolyo-cms\"",
    "dev": "WATCHPACK_POLLING=true next dev -H 127.0.0.1 -p 3000",
    "dev:fresh": "npm run clean && npm run dev",
    "dev:lan": "WATCHPACK_POLLING=true next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "PLAYWRIGHT_BASE_URL=https://kruvtest-test.online playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.75.0",
    "resend": "^6.12.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vercel": "^52.0.0"
  }
}
